go_test(
    name = "jwt_test",
    srcs = ["verifier_test.go"],
    embed = [":jwt"],
    deps = [
        "@com_github_golang_jwt_jwt_v5//:jwt",
        "@com_github_stretchr_testify//require",
    ],
)
